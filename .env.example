# Copy to .env and fill in. .env is git-ignored.
# Variable names match the Couchbase MCP server, so the loader and MCP share this file.

CB_CONNECTION_STRING=couchbases://cb.xxxxxxxx.cloud.couchbase.com
CB_USERNAME=cbimport
CB_PASSWORD=change-me

# Only needed for self-managed clusters with a self-signed cert (not for Capella)
# CB_CA_CERT_PATH=/path/to/root-certificate.txt

# Loader target
CB_BUCKET=quantic
CB_SCOPE=pos

# MCP server: keep the demo read-only
CB_MCP_READ_ONLY_MODE=true
